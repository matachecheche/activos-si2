# ============================================================
# PLANTILLA de credenciales de las pasarelas de pago (Sprint 3).
# Copia este archivo como "pasarelas.env" y rellena tus claves.
#
#   copy pasarelas.env.ejemplo pasarelas.env      (Windows)
#   cp    pasarelas.env.ejemplo pasarelas.env      (Linux/Mac)
#
# "pasarelas.env" lo lee solo el backend cuando arrancas el proyecto:
# asi puedes probar en local con las mismas claves que usaste en Azure.
# NUNCA subas "pasarelas.env" a un repositorio ni lo compartas.
# ============================================================

# --- Proveedor activo: MERCADO_PAGO | PAYPAL | STRIPE | QR
APP_PAGOS_PROVEEDOR=STRIPE

# --- Stripe (https://dashboard.stripe.com/apikeys) --------------------
# Clave secreta: sk_test_... (pruebas) o sk_live_... (produccion)
STRIPE_SECRET_KEY=
# Secreto de firma del webhook: whsec_...
STRIPE_WEBHOOK_SECRET=
# Stripe no cobra en bolivianos: cobra en la moneda de abajo.
STRIPE_MONEDA=usd
# 1 Bs = 1/6,9 USD  ->  100 Bs = 14.49 USD
STRIPE_FACTOR_CONVERSION=6.9

# --- Mercado Pago (https://www.mercadopago.com.bo/developers/panel/app) -
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- PayPal (https://developer.paypal.com/dashboard/applications) -------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_AMBIENTE=live

# --- QR Simple / Red Enlace (ATC) -------------------------------------
APP_PAGOS_QR_CLIENT_ID=
APP_PAGOS_QR_CLIENT_SECRET=
APP_PAGOS_QR_ID_ESTABLECIMIENTO=
APP_PAGOS_QR_NOMBRE_ESTABLECIMIENTO=Activos Fijos
# Certificacion: https://atcgwapitest.redenlace.com.bo/sandbox
# Produccion:    https://api.redenlace.com.bo
APP_PAGOS_QR_BASE_URL=https://atcgwapitest.redenlace.com.bo/sandbox
APP_PAGOS_QR_WEBHOOK_KEY=x-api-key
APP_PAGOS_QR_WEBHOOK_VALUE=
APP_PAGOS_QR_VIGENCIA=900

# --- Transferencia bancaria (opcion sin intermediario) ------------------
# Con estos datos el sistema muestra la cuenta donde depositar y genera un
# codigo de referencia; el administrador de la plataforma confirma el
# deposito y la suscripcion queda activa.
APP_PAGOS_TRANSFERENCIA_BANCO=
APP_PAGOS_TRANSFERENCIA_CUENTA=
APP_PAGOS_TRANSFERENCIA_TITULAR=
APP_PAGOS_TRANSFERENCIA_NIT=
APP_PAGOS_TRANSFERENCIA_SUCURSAL=
APP_PAGOS_TRANSFERENCIA_MONEDA=BOB
# Instrucciones que vera el cliente (opcional).
APP_PAGOS_TRANSFERENCIA_INSTRUCCIONES=

# --- URL publica del backend (para armar el webhook y los retornos) ----
# Local: http://localhost:8080  |  Azure: https://TU-WEBAPP.azurewebsites.net
APP_URL_PUBLICA=http://localhost:8080
# false = cobro real; true = solo demostracion (no cobra nada)
APP_PAGOS_SANDBOX=false
